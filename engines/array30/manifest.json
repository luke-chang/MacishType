{
  "entry": "index.js",
  "name": { "en": "Array", "zh-Hant": "行列" },
  "label": "行",
  "intendedLanguage": "zh-Hant",
  "candidateWindow": {
    "pageSize": 10,
    "indexLabels": "1234567890",
    "macish": {
      "expandable": false
    }
  },
  "modules": {
    "fontCoverage": true,
    "symbolNames": true,
    "wordFrequency": true
  },
  "capabilities": {
    "reverseLookup": true,
    "fullwidthInput": true
  },
  "settings": [
    {
      "title": { "en": "Typing", "zh-Hant": "輸入行為" },
      "fields": [
        {
          "key": "enableAssociatedMode",
          "type": "system",
          "default": true
        },
        {
          "key": "showShortCodePlaceholders",
          "type": "toggle",
          "label": {
            "en": "Show placeholders for empty short-code slots",
            "zh-Hant": "在簡碼空缺的位置顯示佔位符號"
          },
          "description": {
            "en": "Pressing one clears the code you are typing, like any number with no candidate behind it.",
            "zh-Hant": "按下佔位符號會清除正在輸入的字根，與按下沒有候選字的數字相同。"
          },
          "default": false
        },
        {
          "key": "characterSetScope",
          "type": "picker",
          "label": { "en": "Character set", "zh-Hant": "候選字集" },
          "description": {
            "en": "Full keeps the entire table, which may include characters that need an extra font installed to display.",
            "zh-Hant": "完整字集保留整張表格，可能包含需要額外安裝字型才能顯示的字。"
          },
          "style": "menu",
          "default": "displayable",
          "options": [
            { "text": { "en": "Standard", "zh-Hant": "僅標準字集" }, "tag": "standard", "value": "standard" },
            { "text": { "en": "All displayable", "zh-Hant": "全部可顯示字集" }, "tag": "displayable", "value": "displayable" },
            { "text": { "en": "Full", "zh-Hant": "完整字集" }, "tag": "full", "value": "full" }
          ]
        }
      ]
    }
  ]
}
