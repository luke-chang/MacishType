# Traditional Chinese translations for fcitx5-macishtype.
msgid ""
msgstr ""
"Project-Id-Version: fcitx5-macishtype\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: zh_TW\n"

msgid "Engine reloaded"
msgstr "引擎已重新載入"

msgid "Engine load failed"
msgstr "引擎載入失敗"

msgid "See the fcitx5 log for details"
msgstr "詳見 fcitx5 記錄"

msgid "Restart fcitx5 to update the input method list"
msgstr "重新啟動 fcitx5 以更新輸入法清單"

msgid "Restart Now"
msgstr "立即重新啟動"

msgid "Engine removed from disk"
msgstr "引擎已從磁碟移除"

msgid "Engine status changed"
msgstr "引擎狀態已變更"

msgid "%1 reloaded"
msgstr "%1 已重新載入"

msgid "%1 failed to load"
msgstr "%1 載入失敗"

msgid "%1 removed from disk"
msgstr "%1 已從磁碟移除"

msgid "Restore the folder to recover"
msgstr "放回資料夾即可復原"

# Separator between the groups of one reload notice (engine names within a
# group reuse the ", " entry below).
msgid "; "
msgstr "；"

msgid "Auto-reload an engine when its files change"
msgstr "編輯引擎後自動重新載入"

msgid "Notify on engine folder changes"
msgstr "引擎資料夾變動時通知"

msgid "Associated words"
msgstr "關聯字"

msgid "Associated word selection keys"
msgstr "關聯字選字鍵"

msgid "Follow engine"
msgstr "依引擎設定"

msgid "Number keys"
msgstr "數字鍵"

msgid "Shift + number keys"
msgstr "Shift + 數字鍵"

msgid "Allow engines to play the alert sound"
msgstr "允許引擎發出提示音"

msgid ""
"Engines decide when to play it. Which sound it is, and whether it is heard "
"at all, follows the desktop's sound settings."
msgstr "由引擎決定何時發聲。發出哪個聲音、以及是否真的聽得到，都跟隨桌面的音效設定。"

msgid "Enable associated words"
msgstr "啟用關聯字"

msgid "Candidate orientation"
msgstr "候選字方向"

msgid "Follow system default"
msgstr "跟隨系統預設"

msgid "Horizontal"
msgstr "水平"

msgid "Vertical"
msgstr "垂直"

msgid "Placeholder: %1"
msgstr "提示文字：%1"

msgid "Has no effect when %1."
msgstr "當%1時，此設定不生效。"

msgid "“%1” is “%2”"
msgstr "「%1」為「%2」"

msgid "“%1” is not “%2”"
msgstr "「%1」不為「%2」"

msgid "“%1” is one of: %2"
msgstr "「%1」為其中之一：%2"

msgid "“%1” is none of: %2"
msgstr "「%1」皆不為：%2"

msgid " and "
msgstr "且"

msgid " or "
msgstr "或"

msgid "not (%1)"
msgstr "非（%1）"

msgid ", "
msgstr "、"

msgid "Find Input Code"
msgstr "尋找輸入碼"

msgid "Loading…"
msgstr "載入中…"

msgid "Failed to load this input method"
msgstr "無法載入此輸入法"

msgid "Select text first, then run Find Input Code"
msgstr "先選取文字再執行尋找輸入碼"
