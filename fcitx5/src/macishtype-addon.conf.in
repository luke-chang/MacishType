[Addon]
Name=MacishType
Comment=JavaScript input method engine host
Category=InputMethod
Version=@PROJECT_VERSION@
Library=libmacishtype
Type=SharedLibrary
# Dynamic input methods come from listInputMethods(); fcitx5 skips OnDemand
# addons when collecting dynamic entries, so this must stay loaded eagerly.
OnDemand=False
Configurable=True

# Optional: without it the alert sound cannot follow the desktop's choice,
# which is a graceful degrade rather than a failure.
[Addon/OptionalDependencies]
0=dbus
